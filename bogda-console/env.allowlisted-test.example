# Copy to a local env file. Do not commit real values.
# 3101 allowlisted-test against a dedicated runner pool — never 3100, never production pi-service research.

BOGDA_CONSOLE_PROFILE=allowlisted-test
BOGDA_CONSOLE_ROLE=owner
BOGDA_CONSOLE_ACTOR=local-owner
BOGDA_CONSOLE_PUBLIC_HOST=127.0.0.1
BOGDA_CONSOLE_PUBLIC_PORT=3101

PREFECT_API_URL=http://10.77.0.1:4200/api
# PREFECT_API_AUTH_STRING=
# PREFECT_API_KEY=

# Exact IDs from the runner after it registers. No wildcards.
BOGDA_CONSOLE_ALLOWED_DEPLOYMENT_IDS=
BOGDA_CONSOLE_ALLOWED_SCHEDULE_IDS=
BOGDA_CONSOLE_ALLOWED_QUEUE_IDS=
BOGDA_CONSOLE_ALLOWED_WORK_POOL_NAMES=

# Shared with the worker. Same files, not copies. Suggested NAS layout after prepare_runner_share.sh:
# BOGDA_ARTIFACT_ROOT=/mnt/nas/.bogda/runner/artifacts
# BOGDA_USAGE_UNKNOWN_DB=/mnt/nas/.bogda/runner/usage-unknown.sqlite
# BOGDA_APPROVAL_DB=/mnt/nas/.bogda/runner/approvals.sqlite
BOGDA_ARTIFACT_ROOT=
BOGDA_USAGE_UNKNOWN_DB=
BOGDA_APPROVAL_DB=
# python -c "import secrets; print(secrets.token_hex(32))"
BOGDA_APPROVAL_HMAC_KEY=
