# Copy on the box to /etc/bogda/console.env (mode 0640, root:bogda). Do not commit real values.
# First box deploy: real-readonly + observer. Flip to allowlisted-test only with exact IDs.
# Never 3100. Never bind 0.0.0.0 unless BOGDA_CONSOLE_ALLOW_UNSAFE_BIND=1 is reviewed.
# Never put research deployments into pi-service.

BOGDA_CONSOLE_PROFILE=real-readonly
BOGDA_CONSOLE_ROLE=observer
BOGDA_CONSOLE_ACTOR=box-console
BOGDA_CONSOLE_PUBLIC_HOST=127.0.0.1
BOGDA_CONSOLE_PUBLIC_PORT=3101
BOGDA_CONSOLE_REPLICA_COUNT=1

# Optional. Comma list of bind hosts. Loopback is always allowed. Do not list 0.0.0.0 here.
# BOGDA_CONSOLE_SAFE_PUBLIC_HOSTS=127.0.0.1,100.78.158.80
# Messaging only (deploy echo / docs). Not a bind address.
# BOGDA_CONSOLE_MAGICDNS_HOST=rk3528.tail6d8b09.ts.net
# Inbox cap default 8MiB; hard ceiling 32MiB.
# BOGDA_INBOX_MAX_FILE_BYTES=8388608

# Same Prefect as the box worker. Loopback, not 10.77.0.1.
PREFECT_API_URL=http://127.0.0.1:4200/api
# PREFECT_API_AUTH_STRING is copied from /etc/bogda/bogda.env by remote-install when missing.
# DEEPSEEK_API_KEY is copied from bogda.env or orchestra-broker env.conf when missing. Do not paste in git.

# The console OWNS the durable budget/approval/usage-unknown stores on its own
# local disk (never SQLite over CIFS). The runner reaches them only through the
# HMAC-signed /api/v1/store endpoints. /opt/bogda/src must be a real bogda
# source checkout (the systemd unit sets PYTHONPATH=/opt/bogda/src).
BOGDA_APPROVAL_DB=/var/lib/bogda/approvals.sqlite
BOGDA_USAGE_UNKNOWN_DB=/var/lib/bogda/usage-unknown.sqlite
# Same value as the runner; signs credentials and store-api requests.
# BOGDA_APPROVAL_HMAC_KEY=  (copy from /etc/bogda/runner.env, never paste in git)

# Artifact root as seen from THIS host: the Samba share's local path on the box.
BOGDA_ARTIFACT_ROOT=/mnt/nas/.bogda/runner/artifacts

# Autonomy policy (科研自主模式). Box-local core PolicyStore file; setting it wires
# the real policy backend and enables writes for allowlisted-test + owner.
# Leave unset to keep the panel read-only ("策略后端尚未接入").
BOGDA_AUTONOMY_POLICY_PATH=/var/lib/bogda/autonomy-policy.json
# Inbox (brief-sized only, 8MiB/file): /mnt/nas/.bogda/inbox/<run_id>/<file>
# Create dirs with: sudo bash bogda/deploy/shared/prepare_runner_share.sh
# Leave empty until the runner pool exists. Joint work-pool allowlist is mandatory for writes.
BOGDA_CONSOLE_ALLOWED_DEPLOYMENT_IDS=
BOGDA_CONSOLE_ALLOWED_SCHEDULE_IDS=
BOGDA_CONSOLE_ALLOWED_QUEUE_IDS=
BOGDA_CONSOLE_ALLOWED_WORK_POOL_NAMES=
