[Unit]
Description=Bogda Prefect database snapshot
RequiresMountsFor=/mnt/nas/.bogda
ConditionPathIsMountPoint=/mnt/nas
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=oneshot
User=bogda
Group=bogda
EnvironmentFile=/etc/bogda/bogda.env
Restart=on-failure
RestartSec=10s
ExecCondition=/bin/sh -c 'test "$(/usr/bin/findmnt -no FSTYPE /mnt/nas)" = "ext4"'
ExecStart=/opt/bogda/.venv/bin/python -m bogda.ops.snapshot create --source /mnt/nas/.bogda/prefect/prefect.db --destination /mnt/nas/.bogda/snapshots --keep 7
