# Copy to ~/.config/bogda/runner.env on the WSL runner. Do not commit real values.
# This laptop is the stand-in research worker. It is not Wake Bridge and not a 7x24 dorm tower.

# Prefer Tailscale. LAN only when you are on the same switch as the box.
PREFECT_API_URL=http://rk3528.tail6d8b09.ts.net:4200/api
# PREFECT_API_URL=http://10.77.0.1:4200/api
# PREFECT_API_AUTH_STRING=

BOGDA_RESEARCH_POOL=dorm-x86
BOGDA_WORKER_LIMIT=1

# Console-owned durable stores. The runner never opens the SQLite files
# directly; budget/approval/usage-unknown calls go through this HMAC-signed
# narrow API on the box. Use the MagicDNS name: the box exposes 3101 through
# `tailscale serve`, which routes by Host header — a raw tailnet IP would be
# answered 404 by tailscaled itself.
BOGDA_STORE_API_URL=http://rk3528.tail6d8b09.ts.net:3101

# Shared artifact root: runner writes over CIFS, the box reads locally.
BOGDA_ARTIFACT_ROOT=/mnt/nas/.bogda/runner/artifacts
# python -c "import secrets; print(secrets.token_hex(32))"
# Put the same key on the box. Never paste it into chat or git.
# Signs approval credentials AND store-api requests (domain-separated).
BOGDA_APPROVAL_HMAC_KEY=

# CIFS target for mount-nas.sh. Tailscale hostname first.
NAS_UNC=//rk3528.tail6d8b09.ts.net/nas
NAS_MOUNT=/mnt/nas
NAS_CRED_FILE=/home/REPLACE/.config/bogda/nas.cred

# Attempt / dsh session stay on the WSL ext4 disk, not /mnt/c and not D:\
BOGDA_RUNNER_WORK=/home/REPLACE/bogda-work
