[Unit]
Description=Orchestra Yuketang exam watch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=liuxfs
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# SMTP 凭据：与 orchestra-broker 相同机制 —— 由 drop-in
# /etc/systemd/system/orchestra-exam-watch.service.d/env.conf 注入
# （EnvironmentFile= 复用 broker 的 env.conf 会因格式不兼容注入失败，勿改回）
Environment=EXAM_COOKIE_FILE=/mnt/broker/exam_cookie.txt
Environment=EXAM_STATE_FILE=/mnt/broker/exam_watch_state.json
Environment=EXAM_ALERT_FILE=/mnt/broker/results/exam_alert.json
Environment=EXAM_BEAT_FILE=/mnt/broker/results/exam_watch_beat.json
ExecStart=/usr/bin/python3 /home/liuxfs/broker/exam_watch.py
StandardOutput=journal
StandardError=journal
