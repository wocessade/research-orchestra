{
  "codex_modes": {
    "mutual-review": {
      "must_contain": [
        "counter-evidence",
        "\"trigger\"",
        "\"impact\"",
        "\"confidence\"",
        "\"validation_test\"",
        "no artificial sentence limit"
      ],
      "must_not_contain": ["Be concise."]
    },
    "dual-implement": {
      "must_contain": [
        "Do not modify anything outside codex_impl",
        "exactly one valid JSON array",
        "<relative path under codex_impl>"
      ],
      "must_not_contain": ["modify the tests"]
    },
    "claim-check": {
      "must_contain": [
        "not enough information",
        "\"counter_evidence\"",
        "\"missing_context\"",
        "\"confidence\"",
        "no artificial sentence limit"
      ],
      "must_not_contain": ["must choose true or false"]
    }
  },
  "radar_rank": {
    "must_contain": [
      "支持评分的具体证据",
      "可能削弱该评分的反证",
      "当前输入缺失的信息",
      "confidence",
      "不能伪造成确定事实"
    ],
    "must_not_contain": [
      "作者名气、机构声望、引用量和数据库来源进入总分",
      "缺失信息按 0 分"
    ]
  }
}
