{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "academic-shared/evidence-ledger/ledger-schema.json",
  "title": "Evidence Ledger Entry",
  "description": "A single claim entry in the evidence ledger, mapping a claim to its source reference",
  "type": "object",
  "required": [
    "claim_id",
    "section",
    "paragraph_index",
    "claim_text",
    "source_ref",
    "confidence",
    "claim_type",
    "audit_status"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-\\d{3,6}$",
      "description": "Unique claim identifier, e.g. CLM-001"
    },
    "section": {
      "type": "string",
      "description": "Section number, e.g. '2.3'",
      "examples": [
        "1",
        "2.1",
        "3.4.2"
      ]
    },
    "subsection": {
      "type": "string",
      "description": "Optional subsection identifier",
      "examples": [
        "2.3.1",
        "3.1"
      ]
    },
    "paragraph_index": {
      "type": "integer",
      "minimum": 0,
      "description": "0-based paragraph index within the section"
    },
    "claim_text": {
      "type": "string",
      "minLength": 10,
      "description": "Full sentence containing the claim"
    },
    "source_ref": {
      "type": "string",
      "description": "Citation key or internal evidence ID; empty string when no citation/source is available.",
      "examples": [
        "[McMahan et al., 2017]",
        "[Smith, 2020; Jones, 2021]"
      ]
    },
    "source_excerpt": {
      "type": [
        "string",
        "null"
      ],
      "description": "Verbatim source excerpt; null when unavailable. Paraphrase belongs in claim_text."
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "description": "Writer confidence only; never substitutes for audit_status or source-support verification."
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "factual",
        "attribution",
        "method",
        "result",
        "interpretation"
      ],
      "description": "Type of the claim:\n- factual: statements of fact\n- attribution: attributing a position to an author\n- method: describing a methodology\n- result: reporting results\n- interpretation: interpreting findings"
    },
    "audit_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "orphan",
        "mismatch"
      ],
      "description": "Audit status: pending=not yet audited, verified=passes audit, orphan=no source traceable, mismatch=claim misrepresents source"
    },
    "contribution_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^C[0-9]+$"
    },
    "evidence_kind": {
      "enum": [
        "literature",
        "experiment",
        "derivation",
        "missing"
      ]
    },
    "artifact_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "locator": {
      "type": [
        "string",
        "null"
      ],
      "description": "Page/table/section, metric key, or derivation step."
    },
    "claim_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manuscript_revision": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "audit_status": {
            "const": "verified"
          }
        },
        "required": [
          "audit_status"
        ]
      },
      "then": {
        "required": [
          "locator"
        ],
        "properties": {
          "locator": {
            "type": "string",
            "pattern": "\\S"
          },
          "evidence_kind": {
            "enum": [
              "literature",
              "experiment",
              "derivation"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "source_excerpt",
              "source_ref"
            ],
            "properties": {
              "source_excerpt": {
                "type": "string",
                "pattern": "\\S"
              },
              "source_ref": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          {
            "required": [
              "artifact_path"
            ],
            "properties": {
              "artifact_path": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        ]
      }
    }
  ]
}
